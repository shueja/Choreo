{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choreo.dev/schemas/project.schema.json",
  "title": "Choreo Project File Schema",
  "$defs": {
    "ScalarDimension": {
      "type": "object",
      "description": "Sparse LLNL units base-unit exponents. Omit zero-valued powers; an empty object is dimensionless.",
      "properties": {
        "meter": { "type": "integer" },
        "kilogram": { "type": "integer" },
        "second": { "type": "integer" },
        "ampere": { "type": "integer" },
        "kelvin": { "type": "integer" },
        "mole": { "type": "integer" },
        "candela": { "type": "integer" },
        "currency": { "type": "integer" },
        "count": { "type": "integer" },
        "radian": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "VariableType": {
      "type": "string",
      "enum": [
        "Quantity",
        "Pose2d",
        "Translation2d",
        "Polygon2d",
        "Rotation2d",
        "Transform2d",
        "Twist2d",
        "Rectangle2d",
        "Ellipse2d"
      ],
      "description": "Value type supported by wpilib-expression."
    },
    "VariableBase": {
      "type": "object",
      "properties": {
        "allowDrag": {
          "$ref": "./shared.schema.json#/$defs/AxisDrag",
          "description": "Per-axis field-handle permissions for geometry variables."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Expression-language identifier."
        },
        "namespacePath": {
          "type": "string",
          "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?$",
          "description": "Dot-separated namespace path; empty for the root namespace."
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "description": "wpilib-expression source used to calculate the value."
        }
      },
      "required": ["name", "namespacePath", "expression"]
    },
    "QuantityVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Quantity" },
            "dimension": { "$ref": "#/$defs/ScalarDimension" },
            "value": {
              "type": "number",
              "description": "Latest evaluated value in SI base units."
            }
          },
          "required": ["type", "dimension", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Pose2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Pose2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiPose2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Translation2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Translation2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiTranslation2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Polygon2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Polygon2d" },
            "value": { "$ref": "./shared.schema.json#/$defs/Polygon2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Rotation2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Rotation2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiRotation2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Transform2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Transform2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiTransform2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Twist2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Twist2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiTwist2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Rectangle2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Rectangle2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiRectangle2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Ellipse2dVariableEntry": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/VariableBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Ellipse2d" },
            "value": { "$ref": "./wpi.schema.json#/$defs/WpiEllipse2d" }
          },
          "required": ["type", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ExpressionVariableEntry": {
      "oneOf": [
        { "$ref": "#/$defs/QuantityVariableEntry" },
        { "$ref": "#/$defs/Pose2dVariableEntry" },
        { "$ref": "#/$defs/Translation2dVariableEntry" },
        { "$ref": "#/$defs/Polygon2dVariableEntry" },
        { "$ref": "#/$defs/Rotation2dVariableEntry" },
        { "$ref": "#/$defs/Transform2dVariableEntry" },
        { "$ref": "#/$defs/Twist2dVariableEntry" },
        { "$ref": "#/$defs/Rectangle2dVariableEntry" },
        { "$ref": "#/$defs/Ellipse2dVariableEntry" }
      ],
      "description": "Named wpilib-expression variable with a persisted type and latest evaluated value."
    },
    "Variables": {
      "type": "object",
      "description": "All document-level variables keyed by stable UUID.",
      "properties": {
        "variables": {
          "type": "object",
          "propertyNames": { "$ref": "./shared.schema.json#/$defs/UUID" },
          "additionalProperties": { "$ref": "#/$defs/ExpressionVariableEntry" }
        },
        "order": {
          "type": "array",
          "items": { "$ref": "./shared.schema.json#/$defs/UUID" },
          "uniqueItems": true,
          "description": "Stable declaration order for variable IDs. Omitted in older documents, where UUID order is used."
        }
      },
      "required": ["variables"],
      "additionalProperties": false
    },
    "MotorConfig": {
      "type": "object",
      "description": "Drivetrain motor model parameters.",
      "properties": {
        "freeSpeed": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "No-load speed (rad/s)"
        },
        "stallTorque": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Stall torque (N·m)"
        },
        "kT": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Torque constant (N·m/A)"
        },
        "kV": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Back-EMF constant (V·s/rad)"
        },
        "supplyLimit": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Supply current limit (A)"
        },
        "statorLimit": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Stator current limit (A)"
        }
      },
      "required": [
        "freeSpeed",
        "stallTorque",
        "kT",
        "kV",
        "supplyLimit",
        "statorLimit"
      ],
      "additionalProperties": false
    },
    "RobotConfig": {
      "type": "object",
      "description": "Complete physical robot configuration.",
      "properties": {
        "mass": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Robot mass (kg)"
        },
        "inertia": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Moment of inertia (kg·m²)"
        },
        "gearing": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Motor-to-wheel gear ratio (dimensionless)"
        },
        "radius": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Wheel radius (m)"
        },
        "cof": {
          "$ref": "./shared.schema.json#/$defs/Expr",
          "description": "Wheel coefficient of friction (dimensionless)"
        },
        "wheels": {
          "type": "object",
          "description": "Drive-type-specific wheel configuration. One or more drive types may be configured.",
          "properties": {
            "differential": {
              "type": "object",
              "properties": {
                "trackwidth": {
                  "$ref": "./shared.schema.json#/$defs/Expr",
                  "description": "Distance between the left and right wheel contact patches (m)"
                }
              },
              "required": ["trackwidth"],
              "additionalProperties": false
            },
            "swerve": {
              "type": "object",
              "properties": {
                "modules": {
                  "type": "array",
                  "items": {
                    "$ref": "./shared.schema.json#/$defs/TranslationExpr"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "Module positions relative to robot center. Order is not assumed in the optimizer. (m)"
                }
              },
              "required": ["modules"],
              "additionalProperties": false
            },
            "mecanum": {
              "type": "object",
              "properties": {
                "frontLeft": {
                  "$ref": "./shared.schema.json#/$defs/TranslationExpr"
                },
                "frontRight": {
                  "$ref": "./shared.schema.json#/$defs/TranslationExpr"
                },
                "backLeft": {
                  "$ref": "./shared.schema.json#/$defs/TranslationExpr"
                },
                "backRight": {
                  "$ref": "./shared.schema.json#/$defs/TranslationExpr"
                }
              },
              "required": ["frontLeft", "frontRight", "backLeft", "backRight"],
              "additionalProperties": false
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "bumpers": { "$ref": "./shared.schema.json#/$defs/PolygonExpr" },

        "motor": { "$ref": "#/$defs/MotorConfig" }
      },
      "required": [
        "mass",
        "inertia",
        "gearing",
        "radius",
        "cof",
        "wheels",
        "bumpers",
        "motor"
      ],
      "additionalProperties": false
    },
    "CodeGenConfig": {
      "type": "object",
      "description": "Code generation settings stored in the project file.",
      "properties": {
        "root": {
          "type": "string",
          "description": "Output root directory path. Empty string means 'not set'."
        },
        "genVars": {
          "type": "boolean",
          "description": "Generate named variable accessors.",
          "default": true
        },
        "genTrajData": {
          "type": "boolean",
          "description": "Generate data objects with details on each trajectory.",
          "default": true
        },
        "useChoreoLib": {
          "type": "boolean",
          "description": "Emit ChoreoLib-compatible API calls.",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "ProjectFile": {
      "type": "object",
      "description": "Contents of a .chor project file: robot config, drive type, document-level variables, and code-gen settings.",
      "properties": {
        "uuid": {
          "$ref": "./shared.schema.json#/$defs/UUID",
          "description": "Stable UUID for this project document."
        },
        "name": { "type": "string" },
        "version": {
          "type": "integer",
          "minimum": 4,
          "description": "File format version"
        },
        "type": { "$ref": "./shared.schema.json#/$defs/DriveType" },
        "variables": { "$ref": "#/$defs/Variables" },
        "config": { "$ref": "#/$defs/RobotConfig" },
        "codegen": { "$ref": "#/$defs/CodeGenConfig" }
      },
      "required": [
        "uuid",
        "name",
        "version",
        "type",
        "variables",
        "config",
        "codegen"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [{ "$ref": "#/$defs/ProjectFile" }]
}
