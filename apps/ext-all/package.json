{
    "name": "@choreo/standalone",
    "dependencies": {
        "@choreo/document": "workspace:*",
        "@choreo/math": "workspace:*",
        "@choreo/stores": "workspace:*",
        "@choreo/icons":"workspace:*",
        "@choreo/components":"workspace:*",
        "react": "^19.1.0",
            "@emotion/styled": "^11.14.0",
    "@fontsource-variable/roboto-mono": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "concurrently": "^9.2.0",
    "d3": "^7.9.0",
    "hotkeys-js": "^3.13.9",
    "mathjs": "^14.4.0",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0",
    "mobx-state-tree": "^7.0.2",
    "mobx-utils": "^6.1.0",
    "mst-middlewares": "^6.1.0",
    "react-dom": "^19.1.0",
    "react-toastify": "^11.0.5"
    },
  "private": true,
  "type": "module",
  "scripts": {
    "fmtCpp": "wpiformat",
    "fmtJava": "cd choreolib && bash ./gradlew spotlessApply",
    "fmtJs": "prettier --write .",
    "fmtRs": "cargo fmt",
    "lintJs": "eslint --fix src",
    "lintPy": "mypy --pretty --show-column-numbers choreolib/py",
    "fmt": "pnpm run fmtCpp && pnpm run fmtJava && pnpm run fmtJs && pnpm run fmtRs && pnpm run lintJs",
    "clean": "cargo clean && rm -rf dist && rm -rf node_modules",
    "build": "tauri build -- --workspace",
    "build-cli": "cargo build --release -p choreo-cli",
    "tauri": "tauri",
    "server": "cargo run --bin choreo-server",
    "devExtension": "vite --config ./web/vscode-chor/vite.config.ts",
    "compileExt": "vite build --config ./web/extension/vite.config.ts && vite build --config ./web/vscode-chor/vite.config.ts",
    "watchExt": "concurrently \"vite build --watch --config ./web/vscode-chor/vite.config.ts\" \"vite build --watch --config ./web/vscode-traj/vite.config.ts\" \"vite build --watch --config ./web/extension/vite.config.ts\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tauri-apps/cli": "2.5.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "fs": "^0.0.2",
    "glob": "^11.0.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  }
}
