{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "choreo-document-schema",
  "title": "Choreo Document Schema",
  "description": "Root schema hub exposing the project, trajectory, and progress schemas so generators can materialize the full type set.",
  "$defs": {
    "Expr": { "$ref": "./shared.schema.json#/$defs/Expr" },
    "DriveType": { "$ref": "./shared.schema.json#/$defs/DriveType" },
    "ConstraintScope": { "$ref": "./shared.schema.json#/$defs/ConstraintScope" },
    "UUID": { "$ref": "./shared.schema.json#/$defs/UUID" },
    "WaypointID": { "$ref": "./shared.schema.json#/$defs/WaypointID" },
    "Translation2e": { "$ref": "./shared.schema.json#/$defs/Translation2e" },
    "Pose2e": { "$ref": "./shared.schema.json#/$defs/Pose2e" },
    "Region2e": { "$ref": "./shared.schema.json#/$defs/Region2e" },
    "Dimension": { "$ref": "./project.schema.json#/$defs/Dimension" },
    "Variable": { "$ref": "./project.schema.json#/$defs/Variable" },
    "ExpressionVariableEntry": { "$ref": "./project.schema.json#/$defs/ExpressionVariableEntry" },
    "TranslationVariableEntry": { "$ref": "./project.schema.json#/$defs/TranslationVariableEntry" },
    "PoseVariableEntry": { "$ref": "./project.schema.json#/$defs/PoseVariableEntry" },
    "RegionVariableEntry": { "$ref": "./project.schema.json#/$defs/RegionVariableEntry" },
    "Variables": { "$ref": "./project.schema.json#/$defs/Variables" },
    "MotorConfig": { "$ref": "./project.schema.json#/$defs/MotorConfig" },
    "RobotConfig": { "$ref": "./project.schema.json#/$defs/RobotConfig" },
    "CodeGenConfig": { "$ref": "./project.schema.json#/$defs/CodeGenConfig" },
    "ProjectFile": { "$ref": "./project.schema.json#/$defs/ProjectFile" },
    "Waypoint": { "$ref": "./trajectory.schema.json#/$defs/Waypoint" },
    "MaxVelocity": { "$ref": "./trajectory.schema.json#/$defs/MaxVelocity" },
    "MaxAngularVelocity": { "$ref": "./trajectory.schema.json#/$defs/MaxAngularVelocity" },
    "KeepInCircle": { "$ref": "./trajectory.schema.json#/$defs/KeepInCircle" },
    "HeadingConstraint": { "$ref": "./trajectory.schema.json#/$defs/HeadingConstraint" },
    "ConstraintVariant": { "$ref": "./trajectory.schema.json#/$defs/ConstraintVariant" },
    "Constraint": { "$ref": "./trajectory.schema.json#/$defs/Constraint" },
    "Parameters": { "$ref": "./trajectory.schema.json#/$defs/Parameters" },
    "EventMarkerData": { "$ref": "./trajectory.schema.json#/$defs/EventMarkerData" },
    "EventMarker": { "$ref": "./trajectory.schema.json#/$defs/EventMarker" },
    "WpiTranslation2d": { "$ref": "./trajectory.schema.json#/$defs/WpiTranslation2d" },
    "WpiRotation2d": { "$ref": "./trajectory.schema.json#/$defs/WpiRotation2d" },
    "WpiPose2d": { "$ref": "./trajectory.schema.json#/$defs/WpiPose2d" },
    "WpiChassisVelocities": { "$ref": "./trajectory.schema.json#/$defs/WpiChassisVelocities" },
    "WpiChassisAccelerations": { "$ref": "./trajectory.schema.json#/$defs/WpiChassisAccelerations" },
    "HolonomicSample": { "$ref": "./trajectory.schema.json#/$defs/HolonomicSample" },
    "DifferentialSample": { "$ref": "./trajectory.schema.json#/$defs/DifferentialSample" },
    "HolonomicSamplesContainer": { "$ref": "./trajectory.schema.json#/$defs/HolonomicSamplesContainer" },
    "DifferentialSamplesContainer": { "$ref": "./trajectory.schema.json#/$defs/DifferentialSamplesContainer" },
    "Trajectory": { "$ref": "./trajectory.schema.json#/$defs/Trajectory" },
    "TrajectoryFile": { "$ref": "./trajectory.schema.json#/$defs/TrajectoryFile" },
    "IncompleteTrajectoryProgressMessage": { "$ref": "./progress.schema.json#/$defs/IncompleteTrajectoryProgressMessage" },
    "DiagnosticProgressMessage": { "$ref": "./progress.schema.json#/$defs/DiagnosticProgressMessage" },
    "ErrorProgressMessage": { "$ref": "./progress.schema.json#/$defs/ErrorProgressMessage" },
    "CompleteTrajectoryProgressMessage": { "$ref": "./progress.schema.json#/$defs/CompleteTrajectoryProgressMessage" },
    "ProgressUpdateMessage": { "$ref": "./progress.schema.json#/$defs/ProgressUpdateMessage" }
  },
  "oneOf": [
    { "$ref": "#/$defs/ProjectFile" },
    { "$ref": "#/$defs/TrajectoryFile" },
    { "$ref": "#/$defs/ProgressUpdateMessage" }
  ]
}
