{
    "rust-analyzer.check.overrideCommand": [
        "cargo", "clippy", "--target-dir", "./target/clippy", "--message-format=json"
    ],
    "files.associations": {
        "*.py": "python",
        "*.traj": "json"
    },
    "java.configuration.updateBuildConfiguration": "interactive",
    "cmake.sourceDirectory": "${workspaceFolder}/cpp/choreo_app",
    "cmake.buildDirectory": "${workspaceFolder}/cpp/choreo_app/build-clangcl",
    "cmake.parallelJobs": 1
}
