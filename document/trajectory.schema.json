{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choreo.dev/schemas/trajectory.schema.json",
  "title": "Choreo Trajectory File Schema",
  "$defs": {
    "Waypoint": {
      "type": "object",
      "description": "A trajectory waypoint with pose and optimization hints.",
      "properties": {
        "uuid": { "$ref": "./shared.schema.json#/$defs/UUID", "description": "Stable UUID for this waypoint." },
        "x": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "X position (m)" },
        "y": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Y position (m)" },
        "heading": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Heading (rad)" },
        "intervals": { "type": "integer", "minimum": 0, "description": "Optimization intervals to next waypoint" },
        "split": { "type": "boolean", "description": "Start a new trajectory split here" },
        "fix_translation": { "type": "boolean", "description": "Constrain XY position exactly during optimization" },
        "fix_heading": { "type": "boolean", "description": "Constrain heading exactly during optimization" },
        "override_intervals": { "type": "boolean", "description": "Use intervals instead of auto-selection" }
      },
      "required": ["uuid", "x", "y", "heading", "intervals", "split", "fix_translation", "fix_heading", "override_intervals"],
      "additionalProperties": false
    },
    "MaxVelocity": {
      "type": "object",
      "description": "Constraint: maximum linear speed along the path.",
      "properties": {
        "type": { "type": "string", "const": "MaxVelocity" },
        "max": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Maximum speed (m/s)" }
      },
      "required": ["type", "max"],
      "additionalProperties": false
    },
    "MaxAngularVelocity": {
      "type": "object",
      "description": "Constraint: maximum rotational speed.",
      "properties": {
        "type": { "type": "string", "const": "MaxAngularVelocity" },
        "max": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Maximum angular speed (rad/s)" }
      },
      "required": ["type", "max"],
      "additionalProperties": false
    },
    "KeepInCircle": {
      "type": "object",
      "description": "Constraint: keep the robot within a circular field region.",
      "properties": {
        "type": { "type": "string", "const": "KeepInCircle" },
        "x": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Circle center X (m)" },
        "y": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Circle center Y (m)" },
        "r": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Circle radius (m)" }
      },
      "required": ["type", "x", "y", "r"],
      "additionalProperties": false
    },
    "HeadingConstraint": {
      "type": "object",
      "description": "Constraint: robot heading must stay within tolerance of a target angle.",
      "properties": {
        "type": { "type": "string", "const": "Heading" },
        "heading": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Target heading (rad)" },
        "tolerance": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Allowed deviation (rad)" }
      },
      "required": ["type", "heading", "tolerance"],
      "additionalProperties": false
    },
    "ConstraintVariant": {
      "description": "A typed constraint; discriminated by the 'type' string field.",
      "oneOf": [
        { "$ref": "#/$defs/MaxVelocity" },
        { "$ref": "#/$defs/MaxAngularVelocity" },
        { "$ref": "#/$defs/KeepInCircle" },
        { "$ref": "#/$defs/HeadingConstraint" }
      ]
    },
    "Constraint": {
      "type": "object",
      "description": "A typed constraint applied at or between waypoints.",
      "properties": {
        "uuid": { "$ref": "./shared.schema.json#/$defs/UUID", "description": "Stable UUID for this constraint." },
        "from": { "$ref": "./shared.schema.json#/$defs/WaypointID", "description": "Waypoint the constraint starts at" },
        "to": { "$ref": "./shared.schema.json#/$defs/WaypointID", "description": "Waypoint the constraint ends at (omit for point constraint)" },
        "data": { "$ref": "#/$defs/ConstraintVariant" },
        "enabled": { "type": "boolean" }
      },
      "required": ["uuid", "from", "data", "enabled"],
      "additionalProperties": false
    },
    "Parameters": {
      "type": "object",
      "description": "Trajectory parameters: waypoints, constraints, and target time step.",
      "properties": {
        "waypoints": { "type": "array", "items": { "$ref": "#/$defs/Waypoint" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/Constraint" } },
        "target_dt": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Target optimization time step (s)" }
      },
      "required": ["waypoints", "constraints", "target_dt"],
      "additionalProperties": false
    },
    "EventMarkerData": {
      "type": "object",
      "description": "Timing information anchoring an event marker to the trajectory.",
      "properties": {
        "target": { "oneOf": [{ "$ref": "./shared.schema.json#/$defs/WaypointID" }, { "type": "null" }], "description": "Target waypoint reference; null if not set." },
        "targetTimestamp": { "oneOf": [{ "type": "number" }, { "type": "null" }], "description": "Pre-computed trajectory time at the target waypoint (s); null if not available." },
        "offset": { "$ref": "./shared.schema.json#/$defs/Expr", "description": "Time offset from the target (s)" }
      },
      "required": ["target", "targetTimestamp", "offset"],
      "additionalProperties": false
    },
    "EventMarker": {
      "type": "object",
      "description": "A named event placed at a time on the trajectory.",
      "properties": {
        "uuid": { "$ref": "./shared.schema.json#/$defs/UUID", "description": "Stable UUID for this event marker." },
        "name": { "type": "string" },
        "from": { "$ref": "#/$defs/EventMarkerData" }
      },
      "required": ["uuid", "name", "from"],
      "additionalProperties": false
    },
    "WpiTranslation2d": {
      "type": "object",
      "description": "WPILib Translation2d in metres.",
      "properties": {
        "x": { "type": "number", "description": "X position (m)" },
        "y": { "type": "number", "description": "Y position (m)" }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "WpiRotation2d": {
      "type": "object",
      "description": "WPILib Rotation2d in radians.",
      "properties": {
        "radians": { "type": "number", "description": "Rotation angle (rad)" }
      },
      "required": ["radians"],
      "additionalProperties": false
    },
    "WpiPose2d": {
      "type": "object",
      "description": "WPILib Pose2d with translation and rotation.",
      "properties": {
        "translation": { "$ref": "#/$defs/WpiTranslation2d" },
        "rotation": { "$ref": "#/$defs/WpiRotation2d" }
      },
      "required": ["translation", "rotation"],
      "additionalProperties": false
    },
    "WpiChassisVelocities": {
      "type": "object",
      "description": "WPILib ChassisVelocities in field coordinates.",
      "properties": {
        "vx": { "type": "number", "description": "X velocity (m/s)" },
        "vy": { "type": "number", "description": "Y velocity (m/s)" },
        "omega": { "type": "number", "description": "Angular velocity (rad/s)" }
      },
      "required": ["vx", "vy", "omega"],
      "additionalProperties": false
    },
    "WpiChassisAccelerations": {
      "type": "object",
      "description": "WPILib ChassisAccelerations in field coordinates.",
      "properties": {
        "ax": { "type": "number", "description": "X acceleration (m/s^2)" },
        "ay": { "type": "number", "description": "Y acceleration (m/s^2)" },
        "alpha": { "type": "number", "description": "Angular acceleration (rad/s^2)" }
      },
      "required": ["ax", "ay", "alpha"],
      "additionalProperties": false
    },
    "HolonomicSample": {
      "type": "object",
      "description": "wpi::math::HolonomicSample serialized as JSON.",
      "properties": {
        "time": { "type": "number", "description": "Sample timestamp relative to trajectory start (s)" },
        "pose": { "$ref": "#/$defs/WpiPose2d" },
        "velocity": { "$ref": "#/$defs/WpiChassisVelocities" },
        "acceleration": { "$ref": "#/$defs/WpiChassisAccelerations" }
      },
      "required": ["time", "pose", "velocity", "acceleration"],
      "additionalProperties": false
    },
    "DifferentialSample": {
      "type": "object",
      "description": "wpi::math::DifferentialSample serialized as JSON.",
      "properties": {
        "time": { "type": "number", "description": "Sample timestamp relative to trajectory start (s)" },
        "pose": { "$ref": "#/$defs/WpiPose2d" },
        "velocity": { "$ref": "#/$defs/WpiChassisVelocities" },
        "acceleration": { "$ref": "#/$defs/WpiChassisAccelerations" },
        "leftVelocity": { "type": "number", "description": "Left wheel speed (m/s)" },
        "rightVelocity": { "type": "number", "description": "Right wheel speed (m/s)" }
      },
      "required": ["time", "pose", "velocity", "acceleration", "leftVelocity", "rightVelocity"],
      "additionalProperties": false
    },
    "HolonomicSamplesContainer": {
      "type": "object",
      "description": "WPILib HolonomicTrajectory JSON sample container.",
      "properties": { "samples": { "type": "array", "items": { "$ref": "#/$defs/HolonomicSample" } } },
      "required": ["samples"],
      "additionalProperties": false
    },
    "DifferentialSamplesContainer": {
      "type": "object",
      "description": "WPILib DifferentialTrajectory JSON sample container.",
      "properties": { "samples": { "type": "array", "items": { "$ref": "#/$defs/DifferentialSample" } } },
      "required": ["samples"],
      "additionalProperties": false
    },
    "Trajectory": {
      "type": "object",
      "description": "A generated trajectory for one drive type (Trajectory<SwerveDriveType> or Trajectory<DifferentialDriveType>).",
      "properties": {
        "sample_type": { "type": "string", "enum": ["Swerve", "Differential"], "description": "Drive-type discriminator tag." },
        "waypoints": { "type": "array", "items": { "type": "number" }, "description": "Trajectory timestamps (s) corresponding to each waypoint." },
        "splits": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Sample indices at which trajectory splits begin." },
        "samples": {
          "oneOf": [
            { "$ref": "#/$defs/HolonomicSamplesContainer" },
            { "$ref": "#/$defs/DifferentialSamplesContainer" }
          ],
          "description": "Drive-type-specific trajectory samples serialized by WPILib (Swerve -> HolonomicSample, Differential -> DifferentialSample)."
        }
      },
      "required": ["sample_type", "waypoints", "splits", "samples"],
      "additionalProperties": false
    },
    "TrajectoryFile": {
      "type": "object",
      "description": "Contents of a .traj file: a single named trajectory with its parameters and events.",
      "properties": {
        "uuid": { "$ref": "./shared.schema.json#/$defs/UUID", "description": "Stable UUID for this trajectory document." },
        "name": { "type": "string" },
        "version": { "type": "integer", "minimum": 0, "description": "File format version" },
        "config": { "oneOf": [{ "$ref": "./project.schema.json#/$defs/RobotConfig" }, { "type": "null" }], "description": "Robot config snapshot used when the trajectory was generated; null if not stored." },
        "snapshot": { "oneOf": [{ "$ref": "#/$defs/Parameters" }, { "type": "null" }], "description": "Frozen parameter snapshot from the last generation run; null if not generated yet." },
        "params": { "$ref": "#/$defs/Parameters", "description": "Current (editable) trajectory parameters." },
        "trajectory": { "oneOf": [{ "$ref": "#/$defs/Trajectory" }, { "type": "null" }], "description": "Generated trajectory output; null if not yet generated." },
        "events": { "type": "array", "items": { "$ref": "#/$defs/EventMarker" } }
      },
      "required": ["uuid", "name", "version", "params", "events"],
      "additionalProperties": false
    }
  },
  "oneOf": [{ "$ref": "#/$defs/TrajectoryFile" }]
}
